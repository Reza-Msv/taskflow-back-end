# Application
PROJECT_NAME="TaskFlow API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="taskflow"
POSTGRES_PASSWORD="taskflow_password"
POSTGRES_DB="taskflow_db"
DATABASE_URL="postgresql+asyncpg://taskflow:taskflow_password@localhost:5432/taskflow_db"

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_COOKIE_NAME="taskflow_session"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE="lax"

# Features & Policies
ENABLE_PUBLIC_REGISTRATION=false
MAX_BULK_UPDATE_LIMIT=50
